# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# With no database settings, AeroMind runs on its built-in local database.

# Supabase project: Project Settings > API Keys and Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Connect panel > Session pooler > URI. Encode any symbols in the password.
# For hosting, use the Transaction pooler URI (port 6543) instead.
DATABASE_URL=

# Keeps people signed in. A random secret is generated locally if unset.
# Required when hosted: at least 32 random characters.
SESSION_SECRET=

# Connect an AI provider. Without these, the tutor is unavailable and plans use
# pre-written content, labelled as such. Server only: never use a NEXT_PUBLIC_ name.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. AI_CHAT_MODEL replaces OPENAI_MODEL when set.
AI_PROVIDER=openai
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional limits on AI tutor questions per day.
TUTOR_DAILY_LIMIT=30
TUTOR_GLOBAL_DAILY_LIMIT=500

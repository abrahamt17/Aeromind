# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# With no database settings, AeroMind runs on its built-in local database.

# Supabase project: Project Settings > API Keys and Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Connect panel > Session pooler > URI. Encode any symbols in the password.
DATABASE_URL=

# Keeps people signed in. A random secret is generated if unset.
SESSION_SECRET=

# Connect an AI provider. Without these, plans use pre-written content, labelled as such.
OPENAI_API_KEY=
OPENAI_MODEL=

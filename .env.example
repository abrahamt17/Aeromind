# Optional. AeroMind runs without any of these.
# Copy this file to .env.local to use them. Never commit .env.local.

# Keeps people signed in across reinstalls. A random secret is generated if unset.
SESSION_SECRET=

# Connect an AI provider. Without these, plans are built from pre-written content
# and are labelled as such.
OPENAI_API_KEY=
OPENAI_MODEL=
